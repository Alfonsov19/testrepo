# Copy to .env and fill in. Never commit .env.
# The app reads these from the process environment.

# TypeSafe (Jev) - required for semantic signals.
TYPESAFE_API_KEY=

# Anthropic (Claude) - required for fact extraction and response drafting.
# Without it the app still runs: extraction returns empty facts and every
# inquiry routes REVIEW with an explicit reason. It never fabricates facts.
ANTHROPIC_API_KEY=

# Optional overrides (defaults shown).
# JEV_MODEL=jev-1.13.0
# CLAUDE_MODEL=claude-opus-5
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# CRM_DB_PATH=./crm.db
# SIGNAL_THRESHOLD=0.50
